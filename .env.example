# Digi-Key API credentials. Export these in your shell; the client does not
# read .env files automatically.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Optional
# DIGIKEY_ACCOUNT_ID=
# DIGIKEY_SITE=US
# DIGIKEY_LANGUAGE=en
# DIGIKEY_CURRENCY=USD
# DIGIKEY_SANDBOX=1
# DIGIKEY_API_HOST=api.digikey.com
# DIGIKEY_TIMEOUT_MS=30000
