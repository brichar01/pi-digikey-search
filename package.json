{
  "name": "pi-digikey-product-search",
  "version": "0.1.0",
  "description": "Digi-Key ProductSearch v4 CLI, pi extension and MCP server with an iterative keyword → filter-options → parametric-filter skill.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "mcp",
    "claude-code-plugin",
    "digikey",
    "electronics",
    "part-search"
  ],
  "bin": {
    "digikey-search": "./bin/digikey-search",
    "digikey-search-mcp": "./mcp/server.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "extensions/",
    "mcp/",
    "skills/",
    ".claude-plugin/",
    ".mcp.json",
    "index.ts",
    "install.sh",
    "README.md",
    ".env.example"
  ],
  "pi": {
    "extensions": [
      "./extensions/digikey.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/digikey.mjs && node --check lib/tool.mjs && node --check mcp/server.mjs && node --check bin/digikey-search"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
